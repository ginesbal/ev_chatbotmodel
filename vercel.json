{
    "version": 2,
    "functions": {
        "api/index.py": {
            "runtime": "python3.12",
            "includeFiles": "{app,templates,static}/**",
            "maxDuration": 10,
            "memory": 1024
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ]
}